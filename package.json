{
  "name": "bot",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun ./src/index.ts",
    "check-types": "tsc",
    "dev": "bun run --hot src/index.ts",
    "build": "bun build --compile --minify --bytecode ./src/index.ts --outfile bot",
    "build:prisma": "bun --bun prisma generate",
    "migrate:dev": "bun --bun prisma migrate dev",
    "view": "bun --bun prisma studio",
    "check": "oxlint && oxfmt --write",
    "format": "oxfmt --write"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "discord-api-types": "^0.38.49",
    "discord.js": "^14.26.4",
    "node-cron": "^4.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/client": "7",
    "@types/bun": "latest",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prisma": "7"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
